# Anthropic API key (https://console.anthropic.com/ -> API Keys)
ANTHROPIC_API_KEY=

# --- Telegram bot ---------------------------------------------------------
# 1. Open Telegram and message @BotFather -> /newbot, follow the prompts.
#    It returns a token like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=
# 2. Find YOUR numeric user id: message @userinfobot (or @RawDataBot) and read
#    the "Id" field. Only these ids may use the bot (comma-separated for more).
TELEGRAM_ALLOWED_USER_IDS=123456789

DB_PATH=./rq.db
DIGEST_CRON="0 9 * * SUN"
LOCAL_TZ=America/Los_Angeles
LOG_LEVEL=INFO
